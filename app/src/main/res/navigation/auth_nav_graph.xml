<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="de.kniederelz.pawplan.fragments.AuthLoginFragment"
        tools:layout="@layout/fragment_auth_login">

        <action
            android:id="@+id/action_Login_To_Register"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="de.kniederelz.pawplan.fragments.AuthRegisterFragment"
        tools:layout="@layout/fragment_auth_register">

        <action
            android:id="@+id/action_Register_To_Login"
            app:destination="@id/FirstFragment" />
    </fragment>
</navigation>