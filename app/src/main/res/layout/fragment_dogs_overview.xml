<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dogsOverviewLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".dogs.representation.overview.DogsOverviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/dogsOverviewCaption"
            style="@style/TextAppearance.Material3.TitleLarge.Emphasized"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/dogs_overview_caption" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.App.MySearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dogs_overview_search_name_hint"
                android:maxLines="1"
                android:paddingStart="48dp"
                android:paddingEnd="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dogFilterAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:padding="0dp"
                android:text="@string/dogs_overview_search_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dogFilterFavsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:padding="0dp"
                android:text="@string/dogs_overview_search_favs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dogFilterSmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:padding="0dp"
                android:text="@string/dogs_overview_search_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dogFilterMidButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:padding="0dp"
                android:text="@string/dogs_overview_search_mid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dogFilterLargeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:padding="0dp"
                android:text="@string/dogs_overview_search_large" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dogOverviewList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/fragment_dogs_overview_item" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>